# Copy to .env (./run.sh does this for you on first dev run).
# deploy.sh generates a production .env on the server on first deploy.

APP_ENV=dev

DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=drupal
DB_ROOT_PASSWORD=root
HASH_SALT=change-me

# Comma-separated host regexes. Empty = allow any host (dev only).
TRUSTED_HOSTS=

# Drupal cron interval in seconds (also drives DKAN queues).
CRON_INTERVAL=60

# --- dev only ---
HTTP_PORT=8080
MAILPIT_PORT=8025
DB_PORT_HOST=3306
XDEBUG_MODE=off

# --- prod only (run.sh prod init-env writes these on the server) ---
# PROXY=nginx: host nginx proxies to 127.0.0.1:WEB_PORT (Caddy off).
# PROXY=caddy: Caddy owns 80/443 (also set COMPOSE_PROFILES=caddy).
PROXY=nginx
WEB_PORT=8090
# ":80" for plain HTTP on the server IP, or a domain for automatic HTTPS.
SITE_ADDRESS=:80
HTTPS_PORT=443

# Outgoing mail (prod). In dev, mail goes to Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

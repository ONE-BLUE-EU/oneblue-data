# Host nginx site for oneblue-data (PROXY=nginx mode).
# Generated by: ./run.sh prod nginx-site
# Install:
#   ./run.sh prod nginx-site | sudo tee /etc/nginx/sites-available/oneblue-data
#   sudo ln -sf /etc/nginx/sites-available/oneblue-data /etc/nginx/sites-enabled/oneblue-data
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d __DOMAIN__      # adds HTTPS + the http->https redirect
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    access_log /var/log/nginx/oneblue-data-access.log;
    error_log /var/log/nginx/oneblue-data-error.log;

    # Matches PHP's upload_max_filesize/post_max_size (docker/php/base.ini).
    client_max_body_size 512M;

    # HSTS: browsers go straight to HTTPS on later visits. certbot --nginx turns
    # this block into the HTTPS one, so the header ends up there; browsers ignore
    # it over plain HTTP. No includeSubDomains/preload: other one-blue.eu
    # subdomains may not be HTTPS-only.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # DKAN imports and large uploads can take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# Every Docker image (and build input) used by this project, in one place.
# Loaded by run.sh (and therefore deploy.sh) as a compose --env-file; compose
# passes the base images to docker/Dockerfile as build args.
# To upgrade something, change it here and run ./run.sh up (or redeploy).

# Base images for docker/Dockerfile
PHP_IMAGE=php:8.4-apache-bookworm
NODE_IMAGE=node:18-bookworm-slim
COMPOSER_IMAGE=composer:2
PHP_EXT_INSTALLER_IMAGE=mlocati/php-extension-installer:2

# Service images
MARIADB_IMAGE=mariadb:11.4
CADDY_IMAGE=caddy:2.8-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.21

# Images built from docker/Dockerfile. release.sh replaces APP_IMAGE_PROD in
# each release with oneblue-data:<commit>.
APP_IMAGE_DEV=oneblue-data:dev
APP_IMAGE_PROD=oneblue-data:prod

# Frontend built into the prod image. release.sh resolves the ref to a commit
# and records it in the release, so every release is reproducible.
FRONTEND_REPO=https://github.com/ONE-BLUE-EU/one-blue-frontend.git
FRONTEND_REF=main
